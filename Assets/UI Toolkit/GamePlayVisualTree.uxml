<engine:UXML xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:engine="UnityEngine.UIElements" xmlns:editor="UnityEditor.UIElements" noNamespaceSchemaLocation="../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <Style src="project://database/Assets/UI%20Toolkit/GamePlayStyle.uss?fileID=7433441132597879392&amp;guid=0057a01f10f8a104b86b1ac91a64a56b&amp;type=3#GamePlayStyle" />
    <Style src="project://database/Assets/UI%20Toolkit/MainMenuStyle.uss?fileID=7433441132597879392&amp;guid=897a6b31854c4c44fb43ec89cd14ec8f&amp;type=3#MainMenuStyle" />
    <engine:VisualElement name="MainContainer" style="flex-grow: 0; flex-direction: column; align-items: center; justify-content: center; align-self: auto; width: 100%; flex-shrink: 0; align-content: auto; height: 100%; display: flex;">
        <engine:VisualElement name="OptionsContainer" style="flex-grow: 0; width: 51%; flex-shrink: 0; height: 35%; align-items: center; justify-content: space-around; display: none;">
            <engine:Button text="Resume Game" name="OptionsBackButton" class="button" style="flex-grow: 0; height: 20%; width: 60%;" />
            <engine:Button text="Quit" name="QuitGameButton" class="button" style="flex-grow: 0;" />
        </engine:VisualElement>
        <engine:VisualElement name="GameplayUIContainer" style="flex-grow: 0; width: 100%; flex-shrink: 0; height: 100%; align-items: center; justify-content: space-evenly; align-self: center;">
            <engine:Button text="X" name="OptionsButton" class="button" style="height: 6%; width: 4%; left: 45%; top: 2%;" />
            <engine:Label text="GAME IS PAUSED" name="PausedLabel" class="message_text" style="font-size: 100px; text-overflow: clip; align-self: center; border-top-width: 0; width: 100%; align-items: auto; -unity-text-align: upper-center; border-bottom-width: 0; background-color: rgba(0, 0, 0, 0); height: 20%;" />
            <engine:Label text="&lt;GAME OVER MESSAGE&gt;" name="GameOverLabel" class="message_text" style="font-size: 100px; text-overflow: clip; align-self: center; border-top-width: 0; width: 100%; align-items: auto; -unity-text-align: upper-center; border-bottom-width: 0; background-color: rgba(0, 0, 0, 0); height: 315px;" />
            <engine:Label text="!!  NO AMMO  !!" name="NoAmmoLabel" style="font-size: 50px; -unity-font-style: bold; color: rgb(185, 48, 55); text-shadow: 2.7px 3.8px 0 rgb(0, 0, 0); align-self: center; border-top-width: 207px;" />
            <engine:VisualElement name="AmmoContainer" style="flex-grow: initial; flex-direction: row; background-color: rgb(132, 153, 198); margin-top: 0; -unity-text-align: upper-left; align-items: center; justify-content: center; align-content: auto; width: 796px; border-top-width: 9px; border-right-width: 7px; border-bottom-width: 7px; border-left-width: 7px; border-left-color: rgba(0, 0, 0, 0.63); border-right-color: rgba(0, 0, 0, 0.63); border-top-color: rgba(0, 0, 0, 0.63); border-bottom-color: rgba(0, 0, 0, 0.63); border-top-left-radius: 40px; border-top-right-radius: 40px; border-bottom-right-radius: 40px; border-bottom-left-radius: 40px; align-self: center; height: 120px; background-position-y: bottom 0; flex-shrink: 1; background-size: 100% 100px;">
                <engine:Label text="AMMO:" name="AmmoLabel" class="label" style="align-self: auto; height: 69px; justify-content: flex-start; align-content: auto; background-color: rgba(255, 255, 255, 0); -unity-font-definition: url(&quot;project://database/Library/unity%20default%20resources?fileID=10102&amp;guid=0000000000000000e000000000000000&amp;type=0#LegacyRuntime&quot;); -unity-font-style: bold; text-shadow: 4.5px 4.5px 3.5px rgba(0, 0, 0, 0.91);" />
                <engine:ProgressBar value="75" name="AmmoProgressBar" style="height: 51px; width: 500px; align-self: center; display: flex;" />
            </engine:VisualElement>
        </engine:VisualElement>
    </engine:VisualElement>
</engine:UXML>
