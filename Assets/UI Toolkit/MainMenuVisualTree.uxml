<engine:UXML xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:engine="UnityEngine.UIElements" xmlns:editor="UnityEditor.UIElements" noNamespaceSchemaLocation="../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <Style src="project://database/Assets/UI%20Toolkit/MainMenuStyle.uss?fileID=7433441132597879392&amp;guid=897a6b31854c4c44fb43ec89cd14ec8f&amp;type=3#MainMenuStyle" />
    <engine:VisualElement name="MainMenuBackground" style="align-self: center; align-content: auto; justify-content: flex-start; background-color: rgb(142, 188, 197); width: 100%; height: 1080px; background-image: url(&quot;project://database/Assets/UI%20Toolkit/main_menu_bkg.png?fileID=2800000&amp;guid=b2315eb77bbd81c4480cb143a4245081&amp;type=3#main_menu_bkg&quot;); top: 0; -unity-background-scale-mode: scale-and-crop;">
        <engine:Label text="NoNameYet  Shooter" name="TitleLabel" class="header" style="align-self: center; align-content: auto; top: 0; margin-top: 46px; -unity-text-outline-width: 2px; -unity-text-outline-color: rgb(0, 0, 0); text-shadow: 2.7px 2.5px 5.6px rgb(0, 0, 0);" />
        <engine:VisualElement enabled="true" name="MainMenuContainer" style="background-color: rgba(0, 0, 0, 0); width: 40%; height: 36%; align-self: flex-start; justify-content: space-around; flex-direction: column; align-content: auto; bottom: -508px; left: 141px; display: flex; align-items: flex-start;">
            <engine:Button text="Single Player" name="SinglePlayerGameButton" class="button" />
            <engine:Button text="Multiplayer" name="MultiPlayerGameButton" class="button" />
            <engine:Button text="Settings" name="SettingsButton" class="button" />
            <engine:Button text="Quit Game" name="QuitGameButton" class="button" />
        </engine:VisualElement>
        <engine:VisualElement enabled="true" name="SettingsContainer" style="background-color: rgba(0, 0, 0, 0); width: 40%; height: 36%; align-self: flex-start; justify-content: space-around; flex-direction: column; align-content: auto; bottom: -508px; left: 141px; display: none; align-items: flex-start;">
            <engine:VisualElement name="EnemiesCanShoot" style="flex-grow: 0; width: 74%; height: 15%; flex-direction: row; align-self: auto; align-items: center; flex-shrink: 0;">
                <engine:Label text="Enemies Can Shoot" name="EnemiesCanShootLabel" class="menuLabelText" style="margin-right: 0; -unity-text-align: upper-left; align-items: auto; align-content: auto; width: 92%;" />
                <engine:Toggle toggle-on-label-click="false" value="true" name="EnemiesCanShootToggle" style="flex-shrink: 0; flex-grow: 1; align-self: auto; align-content: auto; align-items: center; height: auto; width: auto; justify-content: flex-start; scale: 2 2;" />
            </engine:VisualElement>
            <engine:VisualElement name="NumberofEnemies" style="flex-grow: 0; width: 74%; height: 19%; flex-direction: row; justify-content: flex-start; align-items: center; align-content: center;">
                <engine:Label text="Number of Enemies" name="NumEnemiesLabel" class="menuLabelText" style="margin-right: 0; -unity-text-align: upper-left; align-items: auto; align-content: auto; width: 78%;" />
                <engine:DropdownField choices="0,1,2,3" name="NumEnemiesDropdown" index="3" class="menuLabelText" style="justify-content: flex-start; align-content: auto; align-items: center; flex-grow: 1; width: auto; scale: 1 1; -unity-text-align: upper-right; color: rgb(255, 255, 255); text-shadow: 3.3px 1.7px 0.5px rgb(0, 0, 0);" />
            </engine:VisualElement>
            <engine:Button text="Back to Main Menu" name="SettingsBackButton" class="button" style="width: 74%;" />
        </engine:VisualElement>
        <engine:VisualElement enabled="true" name="MultiPlayerContainer" style="background-color: rgba(0, 0, 0, 0); width: 40%; height: 36%; align-self: flex-start; justify-content: space-around; flex-direction: column; align-content: auto; bottom: -508px; left: 141px; display: none; align-items: flex-start;">
            <engine:Button text="Host Game" name="HostButton" class="button" style="width: 75%;" />
            <engine:VisualElement name="JoinContainer" style="flex-grow: 1; flex-direction: column; flex-shrink: 0; width: 75%; justify-content: center; align-items: auto; align-self: flex-start; align-content: auto;">
                <engine:Button text="Join Game" name="JoinButton" class="button" style="width: 100%; height: auto;" />
                <engine:TextField label="           IP :" placeholder-text="127.0.0.1" tooltip="Leave blank for local host." hide-placeholder-on-focus="true" name="IpTextField" style="font-size: 35px; -unity-font-style: bold; -unity-text-align: lower-left; word-spacing: -15px; background-color: rgb(188, 188, 188); opacity: 1; padding-left: 13px; color: rgb(255, 255, 255); margin-top: 8px; height: auto; width: 100%; align-self: auto; align-items: center; border-top-left-radius: 17px; border-top-right-radius: 17px; border-bottom-right-radius: 17px; border-bottom-left-radius: 17px; text-shadow: 1px 1.5px 4.2px rgb(0, 0, 0); -unity-font-definition: url(&quot;project://database/Library/unity%20default%20resources?fileID=10102&amp;guid=0000000000000000e000000000000000&amp;type=0#LegacyRuntime&quot;); -unity-background-image-tint-color: rgba(180, 184, 243, 0.55); background-image: url(&quot;project://database/Assets/UI%20Toolkit/kenney_ui-pack/PNG/Blue/Default/button_rectangle_gloss.png?fileID=2800000&amp;guid=6e1913d2806ea4b48b3fc0c1bd5b90a5&amp;type=3#button_rectangle_gloss&quot;); white-space: normal;" />
            </engine:VisualElement>
            <engine:Button text="Back" name="MultiPlayerBackButton" class="button" />
        </engine:VisualElement>
    </engine:VisualElement>
</engine:UXML>
